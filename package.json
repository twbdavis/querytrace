{
  "name": "querytrace",
  "version": "0.1.0",
  "description": "An interactive, visual SQL execution tracer for teaching relational queries.",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/copyWasm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:trace": "tsx scripts/testTrace.ts",
    "test:routes": "tsx scripts/testKeyRoutes.ts && tsx scripts/testKeyRouteSnapshots.ts",
    "test:layout": "tsx scripts/testSchemaLayout.ts && tsx scripts/testTableRowWindow.ts",
    "test:fuzz": "tsx scripts/fuzzTrace.ts",
    "test:dialects": "tsx scripts/testDialects.ts",
    "test:sequence": "tsx scripts/testQuerySequence.ts",
    "test:schema": "tsx scripts/testSchemaStatements.ts",
    "test:security": "tsx scripts/testResourceLimits.ts && tsx scripts/testWorkerRecovery.ts && tsx scripts/testPrototypeNames.ts && tsx scripts/testStoreMutationRace.ts && node scripts/testDependencyAuditPolicy.mjs",
    "audit:release": "node scripts/auditDependencies.mjs",
    "test:browsers": "playwright test",
    "check": "npm run typecheck && npm run test:trace && npm run test:routes && npm run test:layout && npm run test:fuzz && npm run test:dialects && npm run test:compat && npm run test:tour && npm run test:release && npm run test:speed && npm run test:postgres && npm run test:sequence && npm run test:schema && npm run test:security && npm run build",
    "test:release": "tsx scripts/testReleaseAcceptance.ts",
    "test:compat": "tsx scripts/testCompatibility.ts",
    "test:tour": "tsx scripts/testDialectTour.ts",
    "test:speed": "tsx scripts/testTranslatorSpeed.ts",
    "test:postgres": "tsx scripts/testPostgresDifferential.ts",
    "goals": "node scripts/goals.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@xyflow/react": "^12.12.1",
    "codemirror": "^6.0.2",
    "next": "16.4.6",
    "node-sql-parser": "^5.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "1.15.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.187.0",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 128",
    "safari 16.4"
  ]
}
