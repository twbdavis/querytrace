{
  "name": "querytrace",
  "version": "0.1.0",
  "description": "An interactive, visual SQL execution tracer for teaching relational queries.",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/copyWasm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:trace": "tsx scripts/testTrace.ts",
    "test:routes": "tsx scripts/testKeyRoutes.ts && tsx scripts/testKeyRouteSnapshots.ts",
    "test:layout": "tsx scripts/testSchemaLayout.ts && tsx scripts/testTableRowWindow.ts",
    "test:fuzz": "tsx scripts/fuzzTrace.ts",
    "test:dialects": "tsx scripts/testDialects.ts",
    "test:sequence": "tsx scripts/testQuerySequence.ts",
    "test:schema": "tsx scripts/testSchemaStatements.ts",
    "test:security": "tsx scripts/testResourceLimits.ts && tsx scripts/testWorkerRecovery.ts && tsx scripts/testPrototypeNames.ts && tsx scripts/testStoreMutationRace.ts && node scripts/testDependencyAuditPolicy.mjs",
    "audit:release": "node scripts/auditDependencies.mjs",
    "test:browsers": "playwright test",
    "check": "npm run typecheck && npm run test:trace && npm run test:routes && npm run test:layout && npm run test:fuzz && npm run test:dialects && npm run test:sequence && npm run test:schema && npm run test:security && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "next": "16.3.8",
    "node-sql-parser": "^5.4.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ]
}
