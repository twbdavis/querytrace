{
  "name": "querytrace",
  "version": "0.1.0",
  "description": "An interactive, visual SQL execution tracer for teaching relational queries.",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/copyWasm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:trace": "tsx scripts/testTrace.ts",
    "test:browsers": "playwright test",
    "check": "npm run typecheck && npm run test:trace && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@xyflow/react": "^12.3.0",
    "codemirror": "^6.0.2",
    "next": "^16.3.2",
    "node-sql-parser": "^5.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ]
}
