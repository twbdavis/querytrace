# Dependencies
/node_modules/

# Next.js output
/.next/
/out/

# Tests and coverage
/coverage/
/playwright-report/
/test-results/

# TypeScript-generated files
*.tsbuildinfo
next-env.d.ts

# Environment files and deployment state
.env*
!.env.example
